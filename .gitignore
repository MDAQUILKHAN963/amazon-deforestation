# Data — never commit satellite imagery / masks (huge)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model outputs
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Presentation files (not code)
*.pptx

# Editors / OS
.DS_Store
.vscode/
.idea/

# Packaging / test caches
*.egg-info/
.pytest_cache/
.coverage

# Local secrets (GEE service-account keys, API tokens)
.env
*.pem
service-account*.json
